    "markdownLinkText": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownCode": { "dark": "darkCyan", "light": "lightCyan" },
    "markdownBlockQuote": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownEmph": { "dark": "darkPink", "light": "lightPink" },
    "markdownStrong": { "dark": "darkBlue", "light": "lightViolet" },
    "markdownHorizontalRule": { "dark": "darkBorder", "light": "lightBorder" },
