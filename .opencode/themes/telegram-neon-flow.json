    "markdownListEnumeration": { "dark": "darkViolet", "light": "lightViolet" },
    "markdownImage": { "dark": "darkPink", "light": "lightPink" },
    "markdownImageText": { "dark": "darkBlue", "light": "lightBlue" },
    "markdownCodeBlock": { "dark": "#DCE7F6", "light": "#313847" },
