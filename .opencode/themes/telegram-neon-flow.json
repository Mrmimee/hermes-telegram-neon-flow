{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#050811",
    "darkPanel": "#0B1525",
    "darkElement": "#101A2B",
    "darkBorder": "#2B4568",
    "darkBorderSubtle": "#1B2D46",
    "darkText": "#F4F8FF",
    "darkMuted": "#9DAFC8",
    "darkBlue": "#4EA4F5",
    "darkCyan": "#51DFF7",
    "darkViolet": "#918BFF",
    "darkPink": "#FF7CC4",
    "darkGreen": "#6FD3A7",
    "darkYellow": "#E7C775",
    "darkRed": "#FF6877",
    "darkDiffAddBg": "#102D2A",
    "darkDiffRemoveBg": "#351A28",
    "lightBg": "#F3F7FC",
    "lightPanel": "#FFFFFF",
    "lightElement": "#EAF1F8",
    "lightBorder": "#D9E1EC",
